# Токен твоего бота (берётся у @BotFather)
TELEGRAM_TOKEN=

# Твой личный Telegram ID для доступа к админке (узнать у @getmyid_bot).
# Можно перечислить несколько через запятую: 111,222,333
ADMIN_IDS=

# api_id и api_hash с https://my.telegram.org (нужны контейнеру telegram-bot-api)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Приватный чат/канал, куда бот заливает медиа для инлайн-режима (получить file_id).
# Бот должен быть его участником с правом отправки. Без этого инлайн не работает.
CACHE_CHAT_ID=

# file_id картинки-заглушки для инлайна. Отправь фото боту в личку и ответь
# на него командой /placeholder — бот пришлёт готовый file_id.
PLACEHOLDER_PHOTO_FILE_ID=

# Instagram теперь скачивается через instagrapi (приватный API), а не yt-dlp.
# Этот файл с куками используется ТОЛЬКО один раз — как "сид" для самого
# первого логина instagrapi (берёт оттуда sessionid). Формат определяется
# автоматически: подходит и Netscape cookies.txt, и JSON-экспорт из
# Cookie-Editor/EditThisCookie ([{"name": "sessionid", "value": "..."}, ...]
# или {"sessionid": "...", ...}). Расширение файла (.txt/.json) роли не
# играет — главное, чтобы имя совпадало с этой переменной и было
# примонтировано в docker-compose.yml.
# Дальше instagrapi хранит свою собственную сессию в DATA_DIR/instagram_session.json
# и сама её обновляет — после первого успешного запуска этот файл можно
# не трогать (но не удаляй, пригодится, если сессия когда-нибудь протухнет
# и потребуется новый бутстрап).
COOKIES_FILE=cookies_instagram.txt

# Лимиты скачивания.
# С локальным telegram-bot-api (режим --local) потолок отправки — 2 ГБ.
# Без него (облачный api.telegram.org) Telegram не даст отправить больше 50 МБ.
# Максимальный размер файла в обычном качестве (МБ)
MAX_FILE_SIZE_MB=300
# Максимальный размер, если юзер выбрал качество выше дефолтного (МБ).
# По умолчанию 1500 (~1.5 ГБ); можно поднять до 2000 (потолок Telegram).
MAX_FILE_SIZE_MB_HQ=1500
# Потолок высоты видео по умолчанию (px)
MAX_VIDEO_HEIGHT=720

# Прокси для yt-dlp/запросов (если есть блокировки по IP), напр:
# PROXY_URL=http://login:pass@host:port
PROXY_URL=

# Отдельный прокси для .ru-доменов (VK и т.п.) — их CDN часто плохо
# отдаёт трафик за границу. Если не задан, для .ru используется PROXY_URL
# (или прямое соединение). Актуально, если сервер бота стоит не в РФ/СНГ.
# PROXY_URL_RU=http://login:pass@ru-host:port
PROXY_URL_RU=

# Отдельный прокси именно для instagrapi (Instagram). Если не задан,
# используется общий PROXY_URL. Полезно, если у Instagram-аккаунта уже
# есть привязка к конкретному IP/стране (например, резидентный прокси),
# и её нужно сохранять постоянной для этой сессии.
# PROXY_URL_IG=http://login:pass@host:port
PROXY_URL_IG=

# Проверка обновлений: бот раз в 6 часов смотрит релизы на GitHub и, если
# вышла новая версия, пишет об этом каждому админу из ADMIN_IDS (один раз на версию).
# 1 — включено (по умолчанию), 0 — выключить.
UPDATE_CHECK=1
# Репозиторий, откуда проверять релизы (обычно менять не нужно).
UPDATE_REPO=zxcatsu/mediagrabber-bot

# Обычно менять не нужно — задаётся в docker-compose.yml:
# TELEGRAM_API_URL=http://telegram-bot-api:8081
# LOCAL_API_DIR=/var/lib/telegram-bot-api
# DATA_DIR=/app/data
